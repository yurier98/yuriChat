# -----------------------------------------------------------------------------
# Nuxt Studio (required to use Studio in production)
# -----------------------------------------------------------------------------
STUDIO_GITHUB_CLIENT_ID=your_github_oauth_client_id
STUDIO_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# -----------------------------------------------------------------------------
# Runtime config (Nuxt-style env vars)
# These map to runtimeConfig in nuxt.config.ts
# -----------------------------------------------------------------------------
NUXT_DISCORD_USER_ID=your_discord_user_id
NUXT_DISCORD_ID=your_discord_id
NUXT_DISCORD_TOKEN=your_discord_token

NUXT_WAKATIME_USER_ID=your_wakatime_user_id
NUXT_WAKATIME_CODING=your_coding_stats_endpoint_or_payload
NUXT_WAKATIME_EDITORS=your_editors_stats_endpoint_or_payload
NUXT_WAKATIME_LANGUAGES=your_languages_stats_endpoint_or_payload
NUXT_WAKATIME_OS=your_os_stats_endpoint_or_payload

NUXT_OPEN_WEATHER_API_KEY=your_openweather_api_key

NUXT_PUBLIC_I18N_BASE_URL=https://yurier98.github.io

# -----------------------------------------------------------------------------
# Optional legacy aliases (if you still reference these elsewhere)
# -----------------------------------------------------------------------------
DISCORD_USER_ID=your_discord_user_id
DISCORD_ID=your_discord_id
DISCORD_TOKEN=your_discord_token

WAKATIME_USER_ID=your_wakatime_user_id
WAKATIME_CODING=your_coding_stats_endpoint_or_payload
WAKATIME_EDITORS=your_editors_stats_endpoint_or_payload
WAKATIME_LANGUAGES=your_languages_stats_endpoint_or_payload
WAKATIME_OS=your_os_stats_endpoint_or_payload

OPENWEATHER_API_KEY=your_openweather_api_key
